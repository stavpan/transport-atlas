digraph atlas {
  graph [rankdir=LR, splines=true, overlap=false, fontname="DejaVu Sans", bgcolor="white", nodesep=0.25, ranksep=0.9, pad=0.3];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=9, penwidth=1.1, margin="0.10,0.06"];
  edge [color="#9aa3b2", arrowsize=0.55, penwidth=0.7];
  subgraph cluster_found { label="foundations"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    balance [label="the balance law\nflux · divergence", fillcolor="#e8f0fe", color="#1f4fa8"];
    matder [label="material derivative\nLagrangian ↔ Eulerian", fillcolor="#e8f0fe", color="#1f4fa8"];
    tax [label="PDE taxonomy\n+ boundary conditions", fillcolor="#e8f0fe", color="#1f4fa8"];
    dimless [label="dimensionless numbers\nPe · Re · Ra · Da · Kn", fillcolor="#e8f0fe", color="#1f4fa8"];
    const [label="constitutive laws\nFick · Fourier · Darcy", fillcolor="#e8f0fe", color="#1f4fa8"];
    spectral [label="Fourier, Green functions\npropagators", fillcolor="#e6f6f4", color="#0f766e"];
    entropy [label="entropy & variational\nstructure", fillcolor="#f3ecfe", color="#6d28d9"];
    walks [label="random walks, Langevin\nfluctuation–dissipation", fillcolor="#f3ecfe", color="#6d28d9"];
    mem [label="memory & linear response\nMori–Zwanzig", fillcolor="#fef3e2", color="#b45309"];
    higherord [label="higher order\n& dispersive", fillcolor="#f3ecfe", color="#6d28d9"];
    dims [label="dimensions, geometry\n& manifolds", fillcolor="#f3ecfe", color="#6d28d9"];
  }
  subgraph cluster_bulk { label="bulk fluid transport"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    adv [label="advection", fillcolor="#e8f0fe", color="#1f4fa8"];
    conv [label="convection & buoyancy\nRayleigh–Bénard, Marangoni", fillcolor="#e6f6f4", color="#0f766e"];
    vor [label="vorticity & pressure", fillcolor="#f3ecfe", color="#6d28d9"];
    bl [label="boundary layers", fillcolor="#f3ecfe", color="#6d28d9"];
    turb [label="turbulence &\neddy diffusivity", fillcolor="#f3ecfe", color="#6d28d9"];
    taylor [label="shear dispersion\nTaylor–Aris", fillcolor="#f3ecfe", color="#6d28d9"];
    mix [label="mixing & chaotic\nadvection", fillcolor="#f3ecfe", color="#6d28d9"];
    jets [label="jets · plumes · wakes", fillcolor="#f3ecfe", color="#6d28d9"];
    darcy [label="Darcy & porous flow", fillcolor="#e6f6f4", color="#0f766e"];
    rheo [label="non-Newtonian rheology", fillcolor="#fef3e2", color="#b45309"];
  }
  subgraph cluster_micro { label="microscopic transport"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    diff [label="diffusion (Fick)", fillcolor="#e8f0fe", color="#1f4fa8"];
    brown [label="Brownian motion\nEinstein relations", fillcolor="#e6f6f4", color="#0f766e"];
    cond [label="conduction (Fourier)", fillcolor="#e8f0fe", color="#1f4fa8"];
    coefs [label="diffusion coefficients\nfrom kinetic theory", fillcolor="#f3ecfe", color="#6d28d9"];
    knud [label="Knudsen & rarefied\ntransport", fillcolor="#f3ecfe", color="#6d28d9"];
    cross [label="Soret · Dufour\nMaxwell–Stefan", fillcolor="#fef3e2", color="#b45309"];
    ionic [label="Nernst–Planck &\nelectrochemical", fillcolor="#f3ecfe", color="#6d28d9"];
    anom [label="anomalous diffusion\nCTRW, fractional", fillcolor="#f3ecfe", color="#6d28d9"];
  }
  subgraph cluster_inter { label="interaction / source / sink"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    kin [label="reaction kinetics\nArrhenius", fillcolor="#e6f6f4", color="#0f766e"];
    auto [label="autocatalysis &\noscillations", fillcolor="#f3ecfe", color="#6d28d9"];
    rd [label="reaction–diffusion\nTuring patterns", fillcolor="#f3ecfe", color="#6d28d9"];
    front [label="fronts & travelling\nwaves", fillcolor="#f3ecfe", color="#6d28d9"];
    taxis [label="chemotaxis\nKeller–Segel", fillcolor="#f3ecfe", color="#6d28d9"];
    sorp [label="sorption & retardation", fillcolor="#f3ecfe", color="#6d28d9"];
    absorb [label="absorption · dissolution\ninterfacial transfer", fillcolor="#e6f6f4", color="#0f766e"];
    phase [label="phase change\nStefan problem", fillcolor="#e6f6f4", color="#0f766e"];
    sed [label="sedimentation · deposition\nfiltration", fillcolor="#e6f6f4", color="#0f766e"];
    accr [label="accretion · ablation\nsurface growth", fillcolor="#fef3e2", color="#b45309"];
    wells [label="wells · injection · efflux\nbreakthrough", fillcolor="#e6f6f4", color="#0f766e"];
    subs [label="subsidence &\nporoelasticity", fillcolor="#f3ecfe", color="#6d28d9"];
    diss [label="viscous dissipation\nJoule heating", fillcolor="#f3ecfe", color="#6d28d9"];
  }
  subgraph cluster_kin { label="kinetic & radiative"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    bolt [label="Boltzmann equation\nH-theorem", fillcolor="#fef3e2", color="#b45309"];
    bgk [label="BGK · Vlasov\nplasmas", fillcolor="#fef3e2", color="#b45309"];
    fp [label="Fokker–Planck\nKramers escape", fillcolor="#f3ecfe", color="#6d28d9"];
    rte [label="radiative transfer", fillcolor="#e6f6f4", color="#0f766e"];
    neut [label="neutron transport", fillcolor="#fef3e2", color="#b45309"];
    lbm [label="lattice-Boltzmann\nparticle methods", fillcolor="#fef3e2", color="#b45309"];
  }
  subgraph cluster_beyond { label="beyond classical PDEs"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    claw [label="conservation laws\nshocks, entropy solutions", fillcolor="#f3ecfe", color="#6d28d9"];
    hj [label="Hamilton–Jacobi\nviscosity solutions", fillcolor="#fef3e2", color="#b45309"];
    frac [label="nonlocal & fractional\noperators", fillcolor="#f3ecfe", color="#6d28d9"];
    visco [label="memory & viscoelastic\ntransport", fillcolor="#fef3e2", color="#b45309"];
    catt [label="Cattaneo & telegraph\nfinite-speed diffusion", fillcolor="#fef3e2", color="#b45309"];
    pme [label="nonlinear diffusion\nporous medium", fillcolor="#f3ecfe", color="#6d28d9"];
    spde [label="stochastic PDEs\nrandom media", fillcolor="#fef3e2", color="#b45309"];
    homo [label="homogenisation\n& upscaling", fillcolor="#f3ecfe", color="#6d28d9"];
    free [label="free boundaries\nlevel sets, phase field", fillcolor="#f3ecfe", color="#6d28d9"];
    ot [label="optimal transport\n& gradient flows", fillcolor="#fef3e2", color="#b45309"];
    mcont [label="microcontinuum continua", fillcolor="#fef3e2", color="#b45309"];
    vi [label="variational inequalities\nhysteresis", fillcolor="#fef3e2", color="#b45309"];
    mhd [label="MHD & relativistic\ntransport", fillcolor="#fef3e2", color="#b45309"];
    integ [label="integrable systems\n& solitons", fillcolor="#fef3e2", color="#b45309"];
    varpr [label="variational principles\n& Noether", fillcolor="#fef3e2", color="#b45309"];
    delayn [label="delay & retarded\ntransport", fillcolor="#f3ecfe", color="#6d28d9"];
  }
  subgraph cluster_num { label="numerics & inversion"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    disc [label="discretisation: consistency\nstability, convergence", fillcolor="#e6f6f4", color="#0f766e"];
    cfl [label="CFL, stiffness\ntime stepping", fillcolor="#e6f6f4", color="#0f766e"];
    numerr [label="numerical diffusion\n& dispersion", fillcolor="#e6f6f4", color="#0f766e"];
    lim [label="limiters · TVD · WENO", fillcolor="#f3ecfe", color="#6d28d9"];
    split [label="operator splitting\n& multiphysics coupling", fillcolor="#f3ecfe", color="#6d28d9"];
    lin [label="linear solvers\npreconditioning", fillcolor="#f3ecfe", color="#6d28d9"];
    nlin [label="nonlinear solvers\ncontinuation", fillcolor="#f3ecfe", color="#6d28d9"];
    mesh [label="adaptivity, moving meshes\nparallel decomposition", fillcolor="#f3ecfe", color="#6d28d9"];
    mc [label="particle & Monte Carlo\nhybrid methods", fillcolor="#f3ecfe", color="#6d28d9"];
    inv [label="inverse problems &\ndata assimilation", fillcolor="#fef3e2", color="#b45309"];
    ml [label="machine learning &\noperator learning", fillcolor="#fef3e2", color="#b45309"];
    vv [label="verification & validation", fillcolor="#f3ecfe", color="#6d28d9"];
    spd [label="structure-preserving\ndiscretisations", fillcolor="#fef3e2", color="#b45309"];
  }
  subgraph cluster_bridge { label="bridges to other fields"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    fin [label="finance", fillcolor="#f3ecfe", color="#6d28d9"];
    bio [label="biology & medicine", fillcolor="#e6f6f4", color="#0f766e"];
    geo [label="geoscience & climate", fillcolor="#e6f6f4", color="#0f766e"];
    plasma [label="plasma & astrophysics", fillcolor="#f3ecfe", color="#6d28d9"];
    eng [label="engineering devices", fillcolor="#e6f6f4", color="#0f766e"];
    mldata [label="machine learning & data", fillcolor="#f3ecfe", color="#6d28d9"];
    img [label="images & signals", fillcolor="#f3ecfe", color="#6d28d9"];
    soc [label="networks & traffic", fillcolor="#f3ecfe", color="#6d28d9"];
    qm [label="quantum & condensed matter", fillcolor="#fef3e2", color="#b45309"];
    unify [label="one mathematics of transport", fillcolor="#fef3e2", color="#b45309"];
  }
  subgraph cluster_univ { label="universality — the strongest claim"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    atlas [label="the atlas (master note)", fillcolor="#e8f0fe", color="#1f4fa8"];
    flows [label="why everything flows\n(five universal structures)", fillcolor="#f3ecfe", color="#6d28d9"];
    lookup [label="the translation lookup\n(object → transport form)", fillcolor="#e6f6f4", color="#0f766e"];
    mind [label="cognitive science & mind\n(decisions, fields, memory)", fillcolor="#f3ecfe", color="#6d28d9"];
    society [label="social behaviour, economics\n& language", fillcolor="#f3ecfe", color="#6d28d9"];
    algo [label="computation & algorithms\n(Dijkstra, PageRank, SGD)", fillcolor="#f3ecfe", color="#6d28d9"];
    qft [label="physics, chemistry\n& field theory", fillcolor="#fef3e2", color="#b45309"];
    info [label="information, statistics\n& inference", fillcolor="#fef3e2", color="#b45309"];
    maths [label="mathematics itself\n(geometric flows, categories)", fillcolor="#fef3e2", color="#b45309"];
    limits [label="limits of the claim\n(where it stops)", fillcolor="#e6f6f4", color="#0f766e"];
  }
  subgraph cluster_mech { label="recurring mechanisms — the shapes that keep returning"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    eq [label="equilibria &\ncritical points", fillcolor="#e8f0fe", color="#1f4fa8"];
    stab [label="linearisation\n& stability", fillcolor="#e6f6f4", color="#0f766e"];
    bif [label="bifurcation\ntheory", fillcolor="#f3ecfe", color="#6d28d9"];
    nonlin [label="nonlinearity &\nmode coupling", fillcolor="#f3ecfe", color="#6d28d9"];
    chaos [label="chaos &\npredictability", fillcolor="#fef3e2", color="#b45309"];
    crit [label="phase transitions\n& criticality", fillcolor="#f3ecfe", color="#6d28d9"];
    scale [label="scaling & self-\nsimilarity", fillcolor="#e6f6f4", color="#0f766e"];
    dual [label="duality &\ntransforms", fillcolor="#f3ecfe", color="#6d28d9"];
    noise [label="noise-induced\nphenomena", fillcolor="#f3ecfe", color="#6d28d9"];
    intermap [label="the intersections\nmap", fillcolor="#e6f6f4", color="#0f766e"];
    biblio [label="bibliography\n(primary · review · sceptical)", fillcolor="#f3ecfe", color="#6d28d9"];
  }
  subgraph cluster_panta { label="panta rhei — all things flow"; labeljust=l; fontsize=11; fontcolor="#475569"; color="#dfe3ea"; style=rounded; margin=12;
    hera [label="Heraclitus\n& the river", fillcolor="#e8f0fe", color="#1f4fa8"];
    beauty [label="beauty & the flow\n(marbling, patterns)", fillcolor="#e8f0fe", color="#1f4fa8"];
    kuram [label="collective behaviour\n& synchrony", fillcolor="#e6f6f4", color="#0f766e"];
    arrow [label="irreversibility &\nthe arrow of time", fillcolor="#e6f6f4", color="#0f766e"];
    crossx [label="crossings & cross-\nfertilisation", fillcolor="#e6f6f4", color="#0f766e"];
    river [label="the river\nas a model", fillcolor="#e8f0fe", color="#1f4fa8"];
  }
